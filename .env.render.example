# Render environment variables for the Vibe-Trading backend.
#
# Copy the values from your Neon project (Vercel integration) into the Render
# service's "Environment" tab. The render.yaml marks DATABASE_URL and
# POSTGRES_URL as `sync: false`, so you must set them manually.
#
#   DATABASE_URL  -> Neon pooled connection string (postgres://...?sslmode=require)
#   POSTGRES_URL  -> same as DATABASE_URL (kept for compatibility)
#
# Optional tuning:
#   VIBE_TRADING_ENABLE_SCHEDULER   -> "true" (set in render.yaml)
#   VIBE_TRADING_CHANNELS_AUTO_START -> "false" (set in render.yaml)
#   PORT                             -> "8899" (set in render.yaml)
#
# LLM provider keys (required for the agent to answer):
#   OPENAI_API_KEY
#   ANTHROPIC_API_KEY
#   (or whichever provider the agent is configured to use)
